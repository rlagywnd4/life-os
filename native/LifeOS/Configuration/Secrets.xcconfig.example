// Copy this file to Secrets.xcconfig. It is intentionally ignored by Git.
// Xcode treats // as a comment in xcconfig files. $() expands to an empty string,
// preserving the two slashes in the final app setting.
SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_KEY

// Optional: enables the local-only "내 계정으로 로그인" button.
// These values are embedded in the app installed on this personal device. Never commit this file.
LIFEOS_ACCOUNT_EMAIL = your-email@example.com
LIFEOS_ACCOUNT_PASSWORD = your-password
